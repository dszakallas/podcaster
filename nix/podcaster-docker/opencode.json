{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["@playwrightMcpPath@", "--headless", "--browser", "chromium"],
      "environment": {
        "PLAYWRIGHT_BROWSERS_PATH": "@playwrightBrowsersPath@"
      }
    }
  },
  "provider": {
    "bailian-payg": {
      "npm": "@anthropicSdkPath@",
      "name": "Alibaba Cloud Model Studio (PAYG)",
      "options": {
        "baseURL": "{env:BAILIAN_BASE_URL}",
        "apiKey": "{env:BAILIAN_API_KEY}"
      },
      "models": {
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
