# Notifiers Configuration
# Environment variables can be configured globally (e.g. PLEX_TOKEN, DISCORD_WEBHOOK_URL)
# or scoped to a specific named notifier using NOTIFIER_${UPPERCASED_NAME}_${VAR_NAME}:

# Global Notifier Defaults / Fallbacks
PLEX_SERVER_URL=
PLEX_TOKEN=
PLEX_SERVER_LIBRARY_PATH=
DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Component-Scoped Notifier Examples (matching presets in podcaster.example.yaml)
# NOTIFIER_MY_PLEX_PLEX_SERVER_URL=http://localhost:32400
# NOTIFIER_MY_PLEX_PLEX_TOKEN=your-plex-token
# NOTIFIER_MY_DISCORD_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Google Gemini / GenAI Configuration
# Note: google-genai library may also look for GOOGLE_API_KEY
GEMINI_API_KEY=
GOOGLE_API_KEY=

# NotebookLM Configuration (Optional)
# NOTEBOOKLM_STORAGE_STATE=
# NOTEBOOKLM_HOME=
